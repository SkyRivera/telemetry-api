# =====================================================================
# telemetry-api - Variables de Entorno
# Copiar este archivo a .env y ajustar los valores para su entorno.
# NUNCA comitear el archivo .env real.
# =====================================================================

# --- Aplicación ---
DEBUG=false
APP_NAME=telemetry-api

# --- Base de Datos (PostgreSQL) ---
POSTGRES_DB=telemetry_db
POSTGRES_USER=telemetry_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
# En desarrollo local (si no usas Docker para Postgres):
# DATABASE_URL=postgresql+asyncpg://telemetry_user:password@localhost:5432/telemetry_db
# En Docker, el docker-compose construye esta URL automáticamente.

# --- Seguridad (API Keys) ---
# Clave para el dispositivo ESP32
API_KEY_ESP32=esp32-secret-key-change-me
# Clave para la aplicación externa (API B)
API_KEY_API_B=api-b-secret-key-change-me

# --- Reglas de Negocio ---
# Tiempo de vida de una solicitud de lectura (segundos)
READ_REQUEST_TIMEOUT_SECONDS=300
# Límite de peticiones
RATE_LIMIT_DEFAULT=100/minute